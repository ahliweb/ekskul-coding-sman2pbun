---
import SectionHeader from './SectionHeader.astro';
import { programs } from '../data/programs';
---

<section id="program" class="py-20 bg-slate-50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      icon="bi-mortarboard"
      title="Program Belajar"
      description="Roadmap pembelajaran coding dari dasar hingga membuat proyek"
    />
    
    <div class="relative">
      <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-blue-200 hidden md:block"></div>
      
      <div class="space-y-8">
        {programs.map((program, index) => (
          <div class="relative flex flex-col md:flex-row gap-6 md:gap-8">
            <div class="hidden md:flex flex-col items-center">
              <div class="w-16 h-16 rounded-full bg-blue-600 text-white flex items-center justify-center text-xl font-bold z-10 shadow-lg">
                {program.level}
              </div>
            </div>
            
            <div class="flex-1 bg-white p-6 rounded-xl shadow-sm border border-slate-100">
              <div class="flex items-center gap-3 mb-4">
                <div class="md:hidden w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold">
                  {program.level}
                </div>
                <h3 class="text-xl font-bold text-slate-900">{program.title}</h3>
              </div>
              
              <ul class="space-y-2">
                {program.topics.map((topic) => (
                  <li class="flex items-center gap-2 text-slate-700">
                    <i class="bi bi-check2 text-blue-600"></i>
                    {topic}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
