---
import SectionHeader from './SectionHeader.astro';
import { faqs } from '../data/faq';
---

<section id="faq" class="py-20 bg-slate-50">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      icon="bi-question-circle"
      title="Pertanyaan Umum (FAQ)"
      description="Jawaban untuk pertanyaan yang sering diajukan"
    />
    
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group bg-white rounded-xl shadow-sm border border-slate-100">
          <summary class="flex items-center justify-between cursor-pointer p-6 list-none">
            <h3 class="font-semibold text-slate-900 pr-4">{faq.question}</h3>
            <span class="text-blue-600 transition-transform group-open:rotate-180">
              <i class="bi bi-chevron-down"></i>
            </span>
          </summary>
          <div class="px-6 pb-6 text-slate-600">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
