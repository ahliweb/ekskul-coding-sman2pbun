---
import { site } from '../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
          <i class="bi bi-code-slash"></i>
          {site.title}
        </h3>
        <p class="text-slate-400">
          Wadah belajar coding, kreativitas digital, dan pengembangan diri siswa SMAN 2 Pangkalan Bun.
        </p>
      </div>
      
      <div>
        <h4 class="text-lg font-semibold text-white mb-4">Link Cepat</h4>
        <ul class="space-y-2">
          <li><a href="#profil" class="hover:text-blue-400 transition-colors">Profil Ekskul</a></li>
          <li><a href="#program" class="hover:text-blue-400 transition-colors">Program Belajar</a></li>
          <li><a href="#jadwal" class="hover:text-blue-400 transition-colors">Jadwal Kegiatan</a></li>
          <li><a href="#kontak" class="hover:text-blue-400 transition-colors">Kontak</a></li>
        </ul>
      </div>
      
      <div>
        <h4 class="text-lg font-semibold text-white mb-4">Kontak</h4>
        <ul class="space-y-2">
          <li class="flex items-center gap-2">
            <i class="bi bi-envelope"></i>
            <a href={site.contact.email} class="hover:text-blue-400 transition-colors">Email</a>
          </li>
          <li class="flex items-center gap-2">
            <i class="bi bi-whatsapp"></i>
            <a href={site.contact.whatsapp} class="hover:text-blue-400 transition-colors">WhatsApp</a>
          </li>
          <li class="flex items-center gap-2">
            <i class="bi bi-calendar-event"></i>
            <span>{site.schedule.day}, {site.schedule.time}</span>
          </li>
        </ul>
      </div>
    </div>
    
    <div class="border-t border-slate-700 mt-8 pt-8 text-center text-slate-400">
      <p>&copy; {currentYear} {site.title}. Seluruh hak cipta dilindungi.</p>
    </div>
  </div>
</footer>
